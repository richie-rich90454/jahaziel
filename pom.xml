<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <!-- Spring Boot 4.1.x. -->
    <version>4.1.0</version>
    <relativePath />
  </parent>

  <groupId>dev.jahaziel</groupId>
  <artifactId>jahaziel</artifactId>
  <!-- Boring default: 0.1.0-SNAPSHOT until the first release (§93). -->
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>Jahaziel</name>
  <description>Self-hosted browser-based development platform: one Linux machine per developer.</description>
  <url>https://github.com/jahaziel-project/jahaziel</url>
  <inceptionYear>2026</inceptionYear>

  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0</url>
    </license>
  </licenses>

  <organization>
    <name>The Jahaziel Authors</name>
  </organization>

  <!-- Reactor modules. -->
  <modules>
    <module>spi</module>
    <module>control-plane</module>
    <module>node-agent</module>
    <module>gateway</module>
  </modules>

  <!-- Pinned versions. Never change without an ADR. -->
  <properties>
    <java.version>25</java.version>
    <maven.compiler.release>25</maven.compiler.release>
    <spring-boot.version>4.1.0</spring-boot.version>
    <spring-framework.version>7.0.0</spring-framework.version>
    <postgresql.version>42.7.13</postgresql.version>
    <flyway.version>13.6.0</flyway.version>
    <hikaricp.version>5.1.0</hikaricp.version>
    <jackson.version>2.17.2</jackson.version>
    <micrometer.version>1.13.5</micrometer.version>
    <spring-security.version>6.3.4</spring-security.version>
    <nimbus-jose-jwt.version>9.40</nimbus-jose-jwt.version>
    <protobuf.version>4.28.2</protobuf.version>
    <grpc.version>1.67.1</grpc.version>
    <junit.version>6.1.3</junit.version>
    <testcontainers.version>1.21.4</testcontainers.version>
    <jqwik.version>1.9.1</jqwik.version>
    <archunit.version>1.5.0</archunit.version>
    <mockito.version>5.23.0</mockito.version>
    <spotbugs.version>4.8.6</spotbugs.version>
    <errorprone.version>2.35.1</errorprone.version>
    <!-- Formatter version tracks the newest release that runs on the build JDK. -->
    <google-java-format.version>1.36.1</google-java-format.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <!-- Pins transitive versions that would otherwise inherit our properties. -->
  <dependencyManagement>
    <dependencies>
      <!-- Testcontainers resolves its own junit.version placeholder against our properties. -->
      <dependency>
        <groupId>junit</groupId>
        <artifactId>junit</artifactId>
        <version>4.13.2</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <plugins>
      <!-- Enforces the license header on every file (see CONTRIBUTING.md). -->
      <plugin>
        <groupId>com.mycila</groupId>
        <artifactId>license-maven-plugin</artifactId>
        <version>5.1.2</version>
        <configuration>
          <strictCheck>true</strictCheck>
          <licenseSets>
            <licenseSet>
              <inlineHeader>Copyright 2026 The Jahaziel Authors
SPDX-License-Identifier: Apache-2.0</inlineHeader>
              <!-- Upstream or spec files that keep their own headers. -->
              <excludes>
                <exclude>mvnw</exclude>
                <exclude>mvnw.cmd</exclude>
                <exclude>.mvn/**</exclude>
                <exclude>LICENSE</exclude>
                <!-- Machine-consumed package list; keeps its own hash comments. -->
                <exclude>base-image-builder/packages.txt</exclude>
                <!-- Spring runtime config; header enforced by the CI tracked-files grep. -->
                <exclude>src/main/resources/application*.yml</exclude>
                <exclude>src/test/resources/application*.yml</exclude>
                <exclude>**/*.patch</exclude>
              </excludes>
            </licenseSet>
          </licenseSets>
          <mapping>
            <java>SLASHSTAR_STYLE</java>
          </mapping>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <!-- Enforces google-java-format. -->
      <plugin>
        <groupId>com.spotify.fmt</groupId>
        <artifactId>fmt-maven-plugin</artifactId>
        <version>2.29</version>
        <executions>
          <execution>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
        <dependencies>
          <dependency>
            <groupId>com.google.googlejavaformat</groupId>
            <artifactId>google-java-format</artifactId>
            <version>${google-java-format.version}</version>
          </dependency>
        </dependencies>
      </plugin>
    </plugins>
  </build>
</project>
