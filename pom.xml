<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <!-- Spring Boot 4.1.x. -->
    <version>4.1.0</version>
    <relativePath />
  </parent>

  <groupId>dev.jahaziel</groupId>
  <artifactId>jahaziel</artifactId>
  <!-- Boring default: 0.1.0-SNAPSHOT until the first release (§93). -->
  <version>0.1.0-SNAPSHOT</version>
  <packaging>jar</packaging>

  <name>Jahaziel</name>
  <description>Self-hosted browser-based development platform: one Linux machine per developer.</description>
  <url>https://github.com/example/jahaziel</url>
  <inceptionYear>2026</inceptionYear>

  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0</url>
    </license>
  </licenses>

  <organization>
    <name>The Jahaziel Authors</name>
  </organization>

  <!-- Single-module layout: all sources live in flat src/main/java. -->

  <!-- Pinned versions. Never change without an ADR. -->
  <properties>
    <java.version>25</java.version>
    <maven.compiler.release>25</maven.compiler.release>
    <spring-boot.version>4.1.0</spring-boot.version>
    <postgresql.version>42.7.13</postgresql.version>
    <sqlite-jdbc.version>3.47.2.0</sqlite-jdbc.version>
    <flyway.version>13.6.0</flyway.version>
    <nimbus-jose-jwt.version>9.40</nimbus-jose-jwt.version>
    <junit.version>6.1.3</junit.version>
    <testcontainers.version>1.21.4</testcontainers.version>
    <archunit.version>1.5.0</archunit.version>
    <mockito.version>5.23.0</mockito.version>
    <!-- Formatter version tracks the newest release that runs on the build JDK. -->
    <google-java-format.version>1.36.1</google-java-format.version>
    <jacoco.version>0.8.15</jacoco.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <!-- Pins transitive versions that would otherwise inherit our properties. -->
  <dependencyManagement>
    <dependencies>
      <!-- Testcontainers resolves its own junit.version placeholder against our properties. -->
      <dependency>
        <groupId>junit</groupId>
        <artifactId>junit</artifactId>
        <version>4.13.2</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <!-- Union of spi, control-plane, node-agent, gateway, dist dependencies.
       Deduped on groupId:artifactId; inter-module dev.jahaziel deps dropped. -->
  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jackson</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <version>${postgresql.version}</version>
    </dependency>
    <dependency>
      <groupId>org.xerial</groupId>
      <artifactId>sqlite-jdbc</artifactId>
      <version>${sqlite-jdbc.version}</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.hibernate.orm</groupId>
      <artifactId>hibernate-community-dialects</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
      <version>${flyway.version}</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-prometheus</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-oauth2-client</artifactId>
    </dependency>
    <dependency>
      <groupId>com.nimbusds</groupId>
      <artifactId>nimbus-jose-jwt</artifactId>
      <version>${nimbus-jose-jwt.version}</version>
    </dependency>
    <dependency>
      <groupId>tools.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <dependency>
      <groupId>org.yaml</groupId>
      <artifactId>snakeyaml</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers</artifactId>
      <version>${testcontainers.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>postgresql</artifactId>
      <version>${testcontainers.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${testcontainers.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-data-jpa-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-jdbc-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit</artifactId>
      <version>${archunit.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-core</artifactId>
      <version>${mockito.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>jahaziel</finalName>
    <plugins>
      <!-- Single executable jar; entry point verified in dist module. -->
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <mainClass>dev.jahaziel.dist.Jahaziel</mainClass>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>repackage</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <!-- Smoke is opt-in (-Psmoke): black-box jar boots stay out of unit runs. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <excludedGroups>smoke</excludedGroups>
          <!-- SQLite unpacks its native library once per JVM and Windows locks it; keep the
            extraction outside per-test temp dirs so @TempDir cleanup never trips over it. -->
          <systemPropertyVariables>
            <org.sqlite.tmpdir>${project.build.directory}/sqlite-native</org.sqlite.tmpdir>
          </systemPropertyVariables>
          <!-- Lets TestEnv tweak process env vars in tests; composed with the JaCoCo agent
            below (propertyName) so coverage keeps working. -->
          <argLine>--add-opens java.base/java.lang=ALL-UNNAMED @{jacocoArgLine}</argLine>
        </configuration>
      </plugin>
      <!-- Creates the SQLite native-extraction dir before surefire forks: the driver does
        not mkdir it, and the first test to open SQLite would otherwise load a broken lib. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-antrun-plugin</artifactId>
        <version>3.1.0</version>
        <executions>
          <execution>
            <id>make-sqlite-native-dir</id>
            <phase>process-test-classes</phase>
            <goals>
              <goal>run</goal>
            </goals>
            <configuration>
              <target>
                <mkdir dir="${project.build.directory}/sqlite-native" />
              </target>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- Coverage: report plus a 100% line/branch gate. Only the exiting
        launcher is excluded; it cannot run inside a test JVM. -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>${jacoco.version}</version>
        <executions>
          <execution>
            <id>prepare-agent</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
            <configuration>
              <propertyName>jacocoArgLine</propertyName>
            </configuration>
          </execution>
          <execution>
            <id>report</id>
            <phase>verify</phase>
            <goals>
              <goal>report</goal>
            </goals>
          </execution>
          <execution>
            <id>check</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
            <configuration>
              <!-- Class-file filter for the analysis input. -->
              <excludes>
                <exclude>**/dist/Jahaziel.class</exclude>
              </excludes>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>1.00</minimum>
                    </limit>
                    <limit>
                      <counter>BRANCH</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>1.00</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- Enforces the license header on every file (see CONTRIBUTING.md). -->
      <plugin>
        <groupId>com.mycila</groupId>
        <artifactId>license-maven-plugin</artifactId>
        <version>5.1.2</version>
        <configuration>
          <strictCheck>true</strictCheck>
          <licenseSets>
            <licenseSet>
              <inlineHeader>Copyright 2026 The Jahaziel Authors
SPDX-License-Identifier: Apache-2.0</inlineHeader>
              <!-- Upstream or spec files that keep their own headers. -->
              <excludes>
                <exclude>mvnw</exclude>
                <exclude>mvnw.cmd</exclude>
                <exclude>jahaziel.bat</exclude>
                <exclude>.mvn/**</exclude>
                <exclude>LICENSE</exclude>
                <!-- Machine-consumed package list; keeps its own hash comments. -->
                <exclude>base-image-builder/packages.txt</exclude>
                <!-- Machine-consumed pins and lists; read verbatim by scripts. -->
                <exclude>ide/upstream-version.txt</exclude>
                <!-- Microsoft upstream checkout; keeps its own headers. -->
                <exclude>ide/upstream/**</exclude>
                <!-- REH build outputs (packaging dir, tarballs, checksums). -->
                <exclude>ide/out/**</exclude>
                <exclude>ide/vscode-reh-web-*/**</exclude>
                <exclude>ide/extensions-builtin/list.txt</exclude>
                <exclude>ide/tests/no-network-test/blocklist.txt</exclude>
                <!-- Generated docs site and vendored frontend deps. -->
                <exclude>docs/.vitepress/dist/**</exclude>
                <exclude>docs/node_modules/**</exclude>
                <!-- Spring runtime config; header enforced by the CI tracked-files grep. -->
                <exclude>src/main/resources/application*.yml</exclude>
                <exclude>src/test/resources/application*.yml</exclude>
                <exclude>**/*.patch</exclude>
              </excludes>
            </licenseSet>
          </licenseSets>
          <mapping>
            <java>SLASHSTAR_STYLE</java>
          </mapping>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <!-- Enforces google-java-format. -->
      <plugin>
        <groupId>com.spotify.fmt</groupId>
        <artifactId>fmt-maven-plugin</artifactId>
        <version>2.29</version>
        <executions>
          <execution>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
        <dependencies>
          <dependency>
            <groupId>com.google.googlejavaformat</groupId>
            <artifactId>google-java-format</artifactId>
            <version>${google-java-format.version}</version>
          </dependency>
        </dependencies>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!--
      Distributable fat jar: bundles the REH tarball built by ide/build.sh into
      the jar, so `init` can stage it and any directory becomes runnable with no
      extra downloads. Fails closed when the tarball is absent; unit runs stay
      slim and fast without this profile.
    -->
    <profile>
      <id>bundled-ide</id>
      <build>
        <resources>
          <resource>
            <directory>ide/out</directory>
            <targetPath>ide</targetPath>
            <includes>
              <include>jahaziel-code-server-*.tar.zst</include>
              <include>jahaziel-code-server-*.tar.zst.sha256</include>
            </includes>
          </resource>
        </resources>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-antrun-plugin</artifactId>
            <version>3.1.0</version>
            <executions>
              <execution>
                <id>require-ide-tarball</id>
                <phase>validate</phase>
                <goals>
                  <goal>run</goal>
                </goals>
                <configuration>
                  <target>
                    <fail message="bundled-ide needs ide/out/jahaziel-code-server-SLUG.tar.zst: run sh ide/build.sh first">
                      <condition>
                        <resourcecount count="0" when="equal">
                          <fileset
                            dir="ide/out"
                            includes="jahaziel-code-server-*.tar.zst" />
                        </resourcecount>
                      </condition>
                    </fail>
                  </target>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <id>smoke</id>
      <properties>
        <jahaziel.jar>${project.basedir}/target/jahaziel.jar</jahaziel.jar>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-surefire-plugin</artifactId>
            <executions>
              <!-- Fresh jar first: test phase still runs units; smoke runs at verify. -->
              <execution>
                <id>smoke</id>
                <phase>verify</phase>
                <goals>
                  <goal>test</goal>
                </goals>
                <configuration>
                  <groups>smoke</groups>
                  <excludedGroups combine.self="override" />
                  <systemPropertyVariables>
                    <jahaziel.jar>${jahaziel.jar}</jahaziel.jar>
                  </systemPropertyVariables>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
