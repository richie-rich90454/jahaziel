-				try {
-					accessTokenResult = await fetching(refreshTokenUri.toString(true), {
-						logger,
-						retryFallbacks: true,
-						expectJSON: true,
-						method: 'POST',
-						headers: {
-							Accept: 'application/json'
-						}
