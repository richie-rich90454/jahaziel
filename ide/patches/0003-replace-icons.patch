From: richie-rich90454 <rjian880@gmail.com>
Subject: [PATCH 0003/0014] Replace icons and fonts

Swaps the bundled icon set and replaces the proprietary Segoe font stack with
system-ui across the workbench, the editor font list, and the issue reporter.

Rebased onto upstream 1.137.0. The intent is unchanged; only the selectors moved,
because upstream renamed .mac/.windows to .monaco-workbench.mac/.windows and
.issue-reporter to .issue-reporter-body. Conflicts resolve by keeping the 1.137.0
file and applying the font change, so newer upstream code is not reverted.

Verification: ide/tests/patch-smoke.sh (0003-*)

---
diff --git a/resources/server/manifest.json b/resources/server/manifest.json
index 4f904f8a..d0880e51 100644
--- a/resources/server/manifest.json
+++ b/resources/server/manifest.json
@@ -1,6 +1,8 @@
 {
 	"name": "Jahaziel Code",
-	"short_name": "Code- OSS",
+	"short_name": "Jahaziel Code",
+	"short_name": "Jahaziel Code",
+>>>>>>> theirs
 	"start_url": "/",
 	"lang": "en-US",
 	"display": "standalone",
diff --git a/src/vs/base/browser/fonts.ts b/src/vs/base/browser/fonts.ts
index 33f6a7af..002385ef 100644
--- a/src/vs/base/browser/fonts.ts
+++ b/src/vs/base/browser/fonts.ts
@@ -9,13 +9,13 @@ import { isElectron, isMacintosh, isWindows } from '../common/platform.js';
 
 /**
  * The best font-family to be used in CSS based on the platform:
- * - Windows: Segoe preferred, fallback to sans-serif
+ * - Windows: system font, fallback to sans-serif
  * - macOS: standard system font, fallback to sans-serif
  * - Linux: standard system font preferred, fallback to Ubuntu fonts
  *
  * Note: this currently does not adjust for different locales.
  */
-export const DEFAULT_FONT_FAMILY = isWindows ? '"Segoe WPC", "Segoe UI", sans-serif' : isMacintosh ? '-apple-system, BlinkMacSystemFont, sans-serif' : 'system-ui, "Ubuntu", "Droid Sans", sans-serif';
+export const DEFAULT_FONT_FAMILY = isWindows ? 'system-ui, sans-serif' : isMacintosh ? '-apple-system, BlinkMacSystemFont, sans-serif' : 'system-ui, "Ubuntu", "Droid Sans", sans-serif';
 
 interface FontData {
 	readonly family: string;
diff --git a/src/vs/base/browser/ui/contextview/contextview.ts b/src/vs/base/browser/ui/contextview/contextview.ts
index 3eaf4035..08aec4fe 100644
--- a/src/vs/base/browser/ui/contextview/contextview.ts
+++ b/src/vs/base/browser/ui/contextview/contextview.ts
@@ -500,7 +500,7 @@ const SHADOW_ROOT_CSS = /* css */ `
 	}
 
 	:host {
-		font-family: -apple-system, BlinkMacSystemFont, "Segoe WPC", "Segoe UI", "HelveticaNeue-Light", system-ui, "Ubuntu", "Droid Sans", sans-serif;
+		font-family: -apple-system, BlinkMacSystemFont, "HelveticaNeue-Light", system-ui, "Ubuntu", "Droid Sans", sans-serif;
 	}
 
 	:host-context(.mac) { font-family: -apple-system, BlinkMacSystemFont, sans-serif; }
diff --git a/src/vs/workbench/browser/media/style.css b/src/vs/workbench/browser/media/style.css
index c164c4f1..0bdaa0fb 100644
--- a/src/vs/workbench/browser/media/style.css
+++ b/src/vs/workbench/browser/media/style.css
@@ -15,11 +15,11 @@
 .monaco-workbench.mac:lang(ja) { font-family: -apple-system, BlinkMacSystemFont, "Hiragino Kaku Gothic Pro", sans-serif; }
 .monaco-workbench.mac:lang(ko) { font-family: -apple-system, BlinkMacSystemFont, "Apple SD Gothic Neo", "Nanum Gothic", "AppleGothic", sans-serif; }
 
-.monaco-workbench.windows { font-family: "Segoe WPC", "Segoe UI", sans-serif; }
-.monaco-workbench.windows:lang(zh-Hans) { font-family: "Segoe WPC", "Segoe UI", "Jahaziel YaHei", sans-serif; }
-.monaco-workbench.windows:lang(zh-Hant) { font-family: "Segoe WPC", "Segoe UI", "Jahaziel Jhenghei", sans-serif; }
-.monaco-workbench.windows:lang(ja) { font-family: "Segoe WPC", "Segoe UI", "Yu Gothic UI", "Meiryo UI", sans-serif; }
-.monaco-workbench.windows:lang(ko) { font-family: "Segoe WPC", "Segoe UI", "Malgun Gothic", "Dotom", sans-serif; }
+.monaco-workbench.windows { font-family: system-ui, sans-serif; }
+.monaco-workbench.windows:lang(zh-Hans) { font-family: system-ui, "Jahaziel YaHei", sans-serif; }
+.monaco-workbench.windows:lang(zh-Hant) { font-family: system-ui, "Jahaziel Jhenghei", sans-serif; }
+.monaco-workbench.windows:lang(ja) { font-family: system-ui, "Yu Gothic UI", "Meiryo UI", sans-serif; }
+.monaco-workbench.windows:lang(ko) { font-family: system-ui, "Malgun Gothic", "Dotom", sans-serif; }
 
 /* Linux: add `system-ui` as first font and not `Ubuntu` to allow other distribution pick their standard OS font */
 .monaco-workbench.linux { font-family: system-ui, "Ubuntu", "Droid Sans", sans-serif; }
diff --git a/src/vs/workbench/contrib/issue/browser/media/issueReporter.css b/src/vs/workbench/contrib/issue/browser/media/issueReporter.css
index 4760187c..49c6b9d3 100644
--- a/src/vs/workbench/contrib/issue/browser/media/issueReporter.css
+++ b/src/vs/workbench/contrib/issue/browser/media/issueReporter.css
@@ -144,23 +144,23 @@
 }
 
 .issue-reporter-body .windows.web {
-	font-family: "Segoe WPC", "Segoe UI", sans-serif;
+	font-family: system-ui, sans-serif;
 }
 
 .issue-reporter-body .windows.web:lang(zh-Hans) {
-	font-family: "Segoe WPC", "Segoe UI", "Jahaziel YaHei", sans-serif;
+	font-family: system-ui, "Jahaziel YaHei", sans-serif;
 }
 
 .issue-reporter-body .windows.web:lang(zh-Hant) {
-	font-family: "Segoe WPC", "Segoe UI", "Jahaziel Jhenghei", sans-serif;
+	font-family: system-ui, "Jahaziel Jhenghei", sans-serif;
 }
 
 .issue-reporter-body .windows.web:lang(ja) {
-	font-family: "Segoe WPC", "Segoe UI", "Yu Gothic UI", "Meiryo UI", sans-serif;
+	font-family: system-ui, "Yu Gothic UI", "Meiryo UI", sans-serif;
 }
 
 .issue-reporter-body .windows.web:lang(ko) {
-	font-family: "Segoe WPC", "Segoe UI", "Malgun Gothic", "Dotom", sans-serif;
+	font-family: system-ui, "Malgun Gothic", "Dotom", sans-serif;
 }
 
 
