From: richie-rich90454 <rjian880@gmail.com>
Subject: [PATCH 0014/0014] Browser compatibility

Tablet and touch hardening for the browser workbench: a viewport-height custom
property, overscroll suppression, tap-highlight removal, touch-action handling,
and coarse-pointer sidebar sizing, plus iPadOS detection. Every hook is
feature-detected and degrades gracefully.

Rebased onto upstream 1.137.0. The style block and hardening script are inserted
into the current markup; the old capture referenced the pre-module script tags
that upstream has since replaced.

Verification: ide/tests/browser/ matrix, manual per release

---
diff --git a/src/vs/code/browser/workbench/workbench.html b/src/vs/code/browser/workbench/workbench.html
index f61b2939..9fdb2e8d 100644
--- a/src/vs/code/browser/workbench/workbench.html
+++ b/src/vs/code/browser/workbench/workbench.html
@@ -28,6 +28,17 @@
 		<link rel="manifest" href="{{WORKBENCH_WEB_BASE_URL}}/resources/server/manifest.json" crossorigin="use-credentials" />
 		<link rel="stylesheet" href="{{WORKBENCH_WEB_BASE_URL}}/out/vs/code/browser/workbench/workbench.css">
 		<link data-name="vs/workbench/workbench.web.main" rel="stylesheet" href="{{WORKBENCH_WEB_BASE_URL}}/out/vs/workbench/workbench.web.main.css">
+		<style>
+			body { overscroll-behavior-y: none; }
+			.jahaziel-touch { -webkit-tap-highlight-color: transparent; }
+			.jahaziel-touch .monaco-workbench { touch-action: manipulation; }
+			@media (max-width: 820px) and (orientation: portrait) {
+				.monaco-workbench .part.sidebar { max-width: 85vw; }
+			}
+			@media (min-width: 821px) and (orientation: landscape) and (pointer: coarse) {
+				.monaco-workbench .part.sidebar { max-width: 40vw; }
+			}
+		</style>
 		<link rel="stylesheet" href="{{WORKBENCH_WEB_BASE_URL}}/resources/server/jahaziel-branding.css">
 
 	</head>
@@ -48,4 +59,30 @@
 	<!-- attempt to load NLS messages in case non-english -->
 	<script type="module" src="{{WORKBENCH_NLS_URL}}"></script>
 	<script type="module" src="{{WORKBENCH_WEB_BASE_URL}}/out/vs/code/browser/workbench/workbench.js"></script>
+	<script>
+		// Jahaziel tablet hardening: viewport height variable, coarse-pointer
+		// and iPadOS hooks, all feature-detected with graceful degradation.
+		(function () {
+			function setViewportVar() {
+				var vh = window.innerHeight * 0.01;
+				document.documentElement.style.setProperty('--jahaziel-vh', vh + 'px');
+			}
+			if (typeof window.addEventListener === 'function') {
+				window.addEventListener('resize', setViewportVar);
+				window.addEventListener('orientationchange', setViewportVar);
+			}
+			setViewportVar();
+			try {
+				if (window.matchMedia && window.matchMedia('(pointer: coarse)').matches) {
+					document.body.classList.add('jahaziel-touch');
+				}
+			} catch (e) { /* stay usable without matchMedia */ }
+			try {
+				var isIPadOS = navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1;
+				if (isIPadOS) {
+					document.body.classList.add('jahaziel-ipados');
+				}
+			} catch (e) { /* stay usable without navigator details */ }
+		})();
+	</script>
 </html>
