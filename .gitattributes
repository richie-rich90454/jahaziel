# Keep patch files and shell scripts LF everywhere so `git apply`
# and `bash` work on Linux checkouts and Windows checkouts alike.
*.patch text eol=lf
*.sh text eol=lf
*.ps1 text eol=lf
*.bat text eol=crlf
# Machine-parsed files break on CRLF: Python entry points, Spring YAML,
# protobuf, nftables, service definitions, the Caddyfile, and Maven POMs.
*.py text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.proto text eol=lf
*.nft text eol=lf
*.service text eol=lf
Caddyfile text eol=lf
*.xml text eol=lf
