# /etc/jahaziel/services/jahaziel-sync-push.service (inside the workspace VM; supervised by jahaziel.jar --run=supervisor)
[Unit]
Description=Jahaziel workspace push (guest to host)
After=network.target

[Service]
Type=oneshot
User=jahaziel-guest
Group=jahaziel-guest
ExecStart=/usr/bin/python3 /usr/local/bin/jahaziel-sync push
NoNewPrivileges=yes
ProtectSystem=strict
PrivateTmp=no
