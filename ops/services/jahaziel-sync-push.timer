# /etc/jahaziel/services/jahaziel-sync-push.timer (inside the workspace VM; scheduled by jahaziel.jar --run=supervisor)
[Unit]
Description=Push workspace files to the host every minute

[Timer]
OnBootSec=60s
OnUnitActiveSec=60s
AccuracySec=10s

[Install]
