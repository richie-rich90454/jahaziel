# /etc/jahaziel/services/jahaziel-code-server.service (inside the workspace VM; supervised by jahaziel.jar --run=supervisor)
[Unit]
Description=Jahaziel Code Server (workspace IDE)
After=network.target jahaziel-guest-agent.service
Wants=network.target

[Service]
Type=simple
User=jahaziel-guest
Group=jahaziel-guest
# Loopback only: the gateway verifies the signed JWT session on every
# connection and reaches the guest over vsock, so no listener here is
# reachable except through the gateway. Guest storage is ephemeral
# (tmpfs); the host home folder is the truth at rest and syncs over
# vsock at start, every minute, and at stop (see jahaziel-sync).
ExecStartPre=/bin/mkdir -p /tmp/jahaziel/workspace /tmp/jahaziel/data
ExecStartPre=/usr/bin/python3 /usr/local/bin/jahaziel-sync pull
ExecStart=/opt/jahaziel-code-server/bin/jahaziel-code-server --host 127.0.0.1 --port 8080 --without-connection-token --server-data-dir /tmp/jahaziel/data --extensions-dir /tmp/jahaziel/data/extensions /tmp/jahaziel/workspace
ExecStop=/usr/bin/python3 /usr/local/bin/jahaziel-sync push
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
PrivateTmp=no

[Install]
WantedBy=multi-user.target
