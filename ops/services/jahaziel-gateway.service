# /etc/jahaziel/services/jahaziel-gateway.service (supervised by jahaziel.jar --run=supervisor)
[Unit]
Description=Jahaziel Gateway
After=network.target
Wants=network.target

[Service]
Type=simple
User=jahaziel-gateway
Group=jahaziel-gateway
EnvironmentFile=/etc/jahaziel/gateway.env
ExecStart=/usr/bin/java -jar /opt/jahaziel/gateway-exec.jar
Restart=on-failure
RestartSec=5
LimitNOFILE=65536
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/log/jahaziel

[Install]
WantedBy=multi-user.target
