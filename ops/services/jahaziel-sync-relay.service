[Unit]
Description=Jahaziel vsock-to-TCP sync relay
After=network.target
Wants=network.target

# Bridges guest vsock (CID 2, port 9002: the only channel guests can
# dial out on) to the node agent sync server on loopback. The relay
# speaks no protocol itself; authentication happens in the hello frame.
[Service]
Type=simple
User=root
ExecStart=/usr/bin/socat VSOCK-LISTEN:9002,fork,reuseaddr TCP:127.0.0.1:19002
Restart=always
RestartSec=2
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
