# /etc/jahaziel/services/jahaziel-node-agent.service (supervised by jahaziel.jar --run=supervisor)
[Unit]
Description=Jahaziel Node Agent
After=network.target
Wants=network.target

[Service]
Type=simple
User=jahaziel-node-agent
Group=jahaziel-node-agent
EnvironmentFile=/etc/jahaziel/node-agent.env
ExecStart=/usr/bin/java -jar /opt/jahaziel/node-agent-exec.jar --config /etc/jahaziel/node-agent.yml
Restart=on-failure
RestartSec=5
LimitNOFILE=65536
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/log/jahaziel /var/lib/jahaziel

[Install]
WantedBy=multi-user.target
