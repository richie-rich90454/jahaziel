  WinSW service template. install.ps1 replaces __JAR_DIR__ before registration.
-->
<service>
  <id>jahaziel</id>
  <name>Jahaziel</name>
  <description>Jahaziel browser development environment</description>
  <executable>java</executable>
  <arguments>-Dserver.address=127.0.0.1 -Djava.io.tmpdir=__JAR_DIR__\data\tmp -jar __JAR_DIR__\jahaziel.jar</arguments>
  <logpath>__JAR_DIR__\data\logs</logpath>
  <logmode>roll</logmode>
  <workingdirectory>__JAR_DIR__</workingdirectory>
  <startmode>Automatic</startmode>
  <onfailure action="restart" delay="5 sec"/>
</service>
