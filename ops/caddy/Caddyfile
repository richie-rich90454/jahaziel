{
    email admin@example.com
    admin off
}

code.example.com {
    encode zstd gzip
    reverse_proxy 127.0.0.1:11451
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "geolocation=(), microphone=(), camera=()"
        Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' wss:; frame-src 'self' https://preview.code.example.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
    }
}

preview.code.example.com {
    encode zstd gzip
    reverse_proxy 127.0.0.1:11451
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        -X-Frame-Options
        Content-Security-Policy "frame-ancestors https://code.example.com"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
}
