<configuration>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <appender name="STRUCTURED" class="dev.jahaziel.ops.StructuredLogbackAppender">
        <dataDir>${jahaziel.storage.root:-data}</dataDir>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="STRUCTURED"/>
    </root>
</configuration>
