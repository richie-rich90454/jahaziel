#
# Copy to .env and fill in, or run `java -jar jahaziel.jar init` to generate.
# Real environment variables always win over .env values.
# Every new setting below is commented out on purpose: uncomment only what you need.

# ---------------------------------------------------------------------------
# DevConnect (basis-auth) IdP. Login stays off until the five core vars are set.
# The legacy BASIS_* names below are kept for existing deployments. The canonical
# BASIS_AUTH_* names are equivalent aliases and are read at startup as well.
# ---------------------------------------------------------------------------
BASIS_AUTH_ISSUER=https://idp.example.com
BASIS_REDIRECT_URI=https://code.example.com/api/oauth/callback
BASIS_CLIENT_ID=jahaziel
# init generates a random secret; replace CHANGE_ME when copying by hand.
BASIS_CLIENT_SECRET=CHANGE_ME
BASIS_RESOURCE=urn:basis:api:jahaziel

# Canonical aliases for the four values above. Use one spelling consistently.
# BASIS_AUTH_CLIENT_ID=jahaziel
# BASIS_AUTH_CLIENT_SECRET=CHANGE_ME
# BASIS_AUTH_RESOURCE=urn:basis:api:jahaziel

# Full basis-auth contract (see docs/basis_auth_setup_guide.md). All optional
# unless you use the matching feature:
# BASIS_AUTH_RESOURCE_SECRET=CHANGE_ME        # verifies backchannel logout/revocation
# BASIS_AUTH_INTERNAL_URL=http://127.0.0.1:3001  # fail-closed user disabled/tokensValidAfter checks
# BASIS_AUTH_SCOPES=openid profile email offline_access projects.read
# BASIS_AUTH_OFFLINE_ACCESS=true              # request a refresh token
# BASIS_ADMIN_BOOTSTRAP_EMAIL=admin@example.com
# BASIS_ADMIN_REQUIRED_ACR=mfa                # ACR proving MFA for the bootstrapped admin
# BASIS_AUTH_PERMISSIONS=jahaziel.workspace:read jahaziel.workspace:write

# ---------------------------------------------------------------------------
# Authentication providers (plugin based). OAuth is one provider, not the only
# login source. Names are ordered by preference. Leave unset to use DevConnect.
# ---------------------------------------------------------------------------
# AUTH_PROVIDERS=basis-auth,microsoft,google,github,oidc,local,passkey,api-token,ldap
# jahaziel.auth.plugin-identity-ttl=PT15M     # bounded plugin identity window

# Microsoft Entra ID
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_ISSUER=https://login.microsoftonline.com/<tenant>/v2.0
# MICROSOFT_REDIRECT_URI=https://code.example.com/api/oauth/callback
# MICROSOFT_SCOPES=openid profile email

# Google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_ISSUER=https://accounts.google.com
# GOOGLE_REDIRECT_URI=https://code.example.com/api/oauth/callback
# GOOGLE_SCOPES=openid profile email

# GitHub OAuth2 (stable subject is the numeric user id)
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_SCOPES=read:user user:email
# GITHUB_AUTHORIZE_URL=https://github.com/login/oauth/authorize
# GITHUB_TOKEN_URL=https://github.com/login/oauth/access_token
# GITHUB_USER_URL=https://api.github.com/user
# GITHUB_EMAILS_URL=https://api.github.com/user/emails

# Generic OIDC (Keycloak, Authentik, etc.)
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_ISSUER=https://idp.example.com
# OIDC_REDIRECT_URI=https://code.example.com/api/oauth/callback
# OIDC_SCOPES=openid profile email

# Local password + TOTP (first admin still needs an IdP or local bootstrap)
# LOCAL_USERNAME=admin
# LOCAL_PASSWORD=CHANGE_ME
# LOCAL_EMAIL=admin@example.com

# Passkey / WebAuthn
# PASSKEY_ORIGIN=https://code.example.com
# PASSKEY_RP_ID=code.example.com
# PASSKEY_RP_NAME=Jahaziel

# API token (service/CLI automation; scoped, expiring, hash-at-rest)
# API_TOKEN_TTL_MILLIS=3600000
# API_TOKEN_ISSUER=https://code.example.com

# LDAP bind authentication
# LDAP_URL=ldaps://ldap.example.com:636
# LDAP_BASE_DN=ou=people,dc=example,dc=com
# LDAP_BIND_DN=
# LDAP_BIND_PASSWORD=
# LDAP_SUBJECT_ATTRIBUTE=entryUUID
# LDAP_EMAIL_ATTRIBUTE=mail
# LDAP_DISPLAY_NAME_ATTRIBUTE=displayName
# LDAP_MFA_ATTRIBUTE=
# LDAP_MFA_VALUE=
# LDAP_USER_FILTER=(uid={0})

# ---------------------------------------------------------------------------
# API and runtime
# ---------------------------------------------------------------------------
# API port (doctor checks this one; JahazielMain --port overrides).
PORT=11451
# Root log level: TRACE, DEBUG, INFO, WARN, ERROR.
JAHAZIEL_LOG_LEVEL=INFO
# true = stub IdP, seed demo user/workspace, ignore BASIS_* (never in production).
JAHAZIEL_DEMO=false
# Workspace backend: local (zero-install) or firecracker (Linux split topology).
JAHAZIEL_BACKEND=local

# Jar-adjacent state and host resolution.
# jahaziel.storage.root=data
# jahaziel.node.id=local
# jahaziel.domain=localhost
# JAHAZIEL_GATEWAY_PORT=8081
# JAHAZIEL_SHARE_SECRET=                 # generated in memory if unset

# Language tools: explicit paths only, no silent downloads.
# jahaziel.language-tools.node-executable=/usr/bin/node

# Agent model catalog: allowlisted ids only; optional loopback local endpoint.
# jahaziel.agent.models=claude-sonnet-4,gpt-4o
# jahaziel.agent.local-endpoint=

# Search index ignore patterns (comma separated).
# jahaziel.search.ignore-patterns=node_modules,.git,dist

# Ops and retention.
# jahaziel.ops.log-max-bytes=10485760
# jahaziel.ops.drain-timeout-ms=15000
# jahaziel.ops.rate-limit-per-minute=5000
# jahaziel.ops.quota-sessions=50
# jahaziel.ops.backup-interval-ms=86400000
# jahaziel.session.idle-timeout-ms=1800000
# jahaziel.audit.retention-days=30
# jahaziel.snapshot.auto-retention-count=30
# jahaziel.snapshot.pre-delete-retention-days=90

# Self-update channel and restricted operation.
# JAHAZIEL_UPDATE_CHANNEL=stable
# JAHAZIEL_OFFLINE=true                  # forbid all tool downloads

# NO_COLOR=1                            # disable ANSI colors in `logs` output
