#
# Copy to .env and fill in, or run `java -jar jahaziel.jar init` to generate.
# Real environment variables always win over .env values.

# DevConnect (basis-auth) IdP. Login stays off until all five are set.
BASIS_AUTH_ISSUER=https://idp.example.com
BASIS_REDIRECT_URI=https://code.example.com/api/oauth/callback
BASIS_CLIENT_ID=jahaziel
# init generates a random secret; replace CHANGE_ME when copying by hand.
BASIS_CLIENT_SECRET=CHANGE_ME
BASIS_RESOURCE=urn:basis:api:jahaziel

# API port (doctor checks this one; JahazielMain --port overrides).
PORT=11451
# Root log level: TRACE, DEBUG, INFO, WARN, ERROR.
JAHAZIEL_LOG_LEVEL=INFO
# true = stub IdP, seed demo user/workspace, ignore BASIS_* (never in production).
JAHAZIEL_DEMO=false
# Workspace backend: local (zero-install) or firecracker (Linux split topology).
JAHAZIEL_BACKEND=local
