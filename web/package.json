{
  "name": "jahaziel-web",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "format": "oxfmt -c oxfmt.config.json --write src",
    "format:check": "oxfmt -c oxfmt.config.json --check src",
    "preview": "vite preview --host 127.0.0.1",
    "test:launch-config": "node --experimental-strip-types --test tests/debug-launch-config.test.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-python": "6.2.1",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "codemirror": "6.0.2",
    "solid-js": "2.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "4.3.5",
    "daisyui": "5.8.1",
    "oxfmt": "0.79.0",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vite-plugin-solid": "2.11.16"
  }
}
