<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>dev.jahaziel</groupId>
    <artifactId>jahaziel</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>jahaziel-dist</artifactId>
  <name>Jahaziel Dist</name>
  <description>Ultra fat jar: control plane, node agent, and gateway in one runnable jar.</description>

  <dependencies>
    <dependency>
      <groupId>dev.jahaziel</groupId>
      <artifactId>jahaziel-spi</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>dev.jahaziel</groupId>
      <artifactId>jahaziel-control-plane</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>dev.jahaziel</groupId>
      <artifactId>jahaziel-node-agent</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>dev.jahaziel</groupId>
      <artifactId>jahaziel-gateway</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>jahaziel</finalName>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <mainClass>dev.jahaziel.dist.JahazielMain</mainClass>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>repackage</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
